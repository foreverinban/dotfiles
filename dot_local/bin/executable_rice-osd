#!/usr/bin/env bash
# rice-osd — действия Fn-клавиш + OSD через swaync (полоска прогресса, одна «живая» нотификация).
#   rice-osd vol up|down|mute   rice-osd mic   rice-osd bri up|down   rice-osd bt
osd() {  # osd <текст> [значение 0-100]
    local args=(-a rice-osd -u low -t 1500 -h string:x-canonical-private-synchronous:rice-osd -h string:synchronous:rice-osd)
    [ -n "${2:-}" ] && args+=(-h "int:value:$2")
    command -v notify-send >/dev/null && notify-send "${args[@]}" "$1"
}
case "${1:-}" in
    vol)
        case "${2:-}" in
            up)   wpctl set-mute @DEFAULT_AUDIO_SINK@ 0; wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+ ;;
            down) wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
            mute) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
        esac
        out=$(wpctl get-volume @DEFAULT_AUDIO_SINK@)          # "Volume: 0.45 [MUTED]"
        v=$(awk '{printf "%d", $2*100 + 0.5}' <<<"$out")
        if [[ "$out" == *MUTED* ]]; then osd "VOL muted" 0; else osd "VOL $v%" "$v"; fi ;;
    mic)
        wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
        if [[ "$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@)" == *MUTED* ]]; then osd "MIC muted"; else osd "MIC on"; fi ;;
    bri)
        command -v brightnessctl >/dev/null || { osd "brightnessctl не установлен"; exit 1; }
        case "${2:-}" in
            up)   brightnessctl -q -e4 -n2 set 5%+ ;;
            down) brightnessctl -q -e4 -n2 set 5%- ;;
        esac
        v=$(brightnessctl -m | cut -d, -f4 | tr -d '%')
        osd "BRI $v%" "$v" ;;
    bt)
        if bluetoothctl show | grep -q 'Powered: yes'; then bluetoothctl power off >/dev/null; osd "BT off"
        else rfkill unblock bluetooth; bluetoothctl power on >/dev/null; osd "BT on"; fi ;;
    *) sed -n '2,4p' "$0"; exit 1 ;;
esac
