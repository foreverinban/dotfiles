#!/usr/bin/env bash
set -euo pipefail

hosts=$(grep -i '^Host ' ~/.ssh/config 2>/dev/null | awk '{print $2}' | grep -v '\*' || true)

if [ -z "$hosts" ]; then
    echo "В ~/.ssh/config нет хостов"
    exit 1
fi

selected=$(echo "$hosts" | fzf --multi --prompt="Выбери серверы (Tab — отметить, Enter — подтвердить): ")

if [ -z "$selected" ]; then
    echo "Ничего не выбрано"
    exit 0
fi

layout_file=$(mktemp --suffix=.kdl)
{
  echo 'layout {'
  echo '    tab name="Magic" {'
  for h in $selected; do
    echo "        pane command=\"ssh\" { args \"$h\" }"
  done
  echo '    }'
  echo '}'
} > "$layout_file"

zellij --layout "$layout_file"
