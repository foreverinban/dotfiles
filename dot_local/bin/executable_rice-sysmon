#!/usr/bin/env bash
# rice-sysmon — виджет нагрузки по ядрам и памяти (второй экземпляр waybar).
#   rice-sysmon         показать/скрыть
#   rice-sysmon open    показать    rice-sysmon close   скрыть
CFG="$HOME/.config/waybar/sysmon.jsonc"; CSS="$HOME/.config/waybar/sysmon.css"
running() { pgrep -f "waybar -c $CFG" >/dev/null; }
start()   { running || (setsid waybar -c "$CFG" -s "$CSS" >/tmp/rice-sysmon.log 2>&1 &); }
stop()    { pkill -f "waybar -c $CFG"; pkill -f rice-sysmon-feed; }
case "${1:-toggle}" in
    open)  start ;;
    close) stop ;;
    *)     if running; then stop; else start; fi ;;
esac
