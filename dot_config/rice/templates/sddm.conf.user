# generated by rice-render → /var/lib/rice-sddm/astronaut.conf.user
# (симлинк из /usr/share/sddm/themes/sddm-astronaut-theme/Themes/, создаёт rice-bootstrap.sh)
[General]
Font="{{font}}"
FontSize="12"
RoundCorners="12"
HourFormat="HH:mm"
DateFormat="dddd · dd.MM.yyyy"
HeaderText=""

Background="Backgrounds/rice.jpg"
CropBackground="true"
DimBackground="0.35"
DimBackgroundColor="{{bg}}"
PartialBlur="true"
BlurMax="48"
Blur="1.4"
HaveFormBackground="false"
FormPosition="center"

HeaderTextColor="{{fg}}"
DateTextColor="{{accent}}"
TimeTextColor="{{fg}}"

FormBackgroundColor="{{bg}}"
BackgroundColor="{{bg}}"

LoginFieldBackgroundColor="{{bg_alt}}"
PasswordFieldBackgroundColor="{{bg_alt}}"
LoginFieldTextColor="{{fg}}"
PasswordFieldTextColor="{{fg}}"
UserIconColor="{{accent}}"
PasswordIconColor="{{accent}}"
PlaceholderTextColor="{{fg_dim}}"
WarningColor="{{urgent}}"

LoginButtonTextColor="{{bg}}"
LoginButtonBackgroundColor="{{accent}}"
SystemButtonsIconsColor="{{fg_dim}}"
SessionButtonTextColor="{{fg_dim}}"
VirtualKeyboardButtonTextColor="{{fg_dim}}"

DropdownTextColor="{{fg}}"
DropdownSelectedBackgroundColor="{{bg_alt2}}"
DropdownBackgroundColor="{{bg_alt}}"

HighlightTextColor="{{bg}}"
HighlightBackgroundColor="{{accent}}"
HighlightBorderColor="{{accent}}"

HoverUserIconColor="{{fg}}"
HoverPasswordIconColor="{{fg}}"
HoverSystemButtonsIconsColor="{{accent}}"
HoverSessionButtonTextColor="{{accent}}"
HoverVirtualKeyboardButtonTextColor="{{accent}}"

HideVirtualKeyboard="true"
PasswordFocus="true"
ForceLastUser="true"
