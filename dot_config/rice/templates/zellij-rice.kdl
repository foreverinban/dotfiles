// generated by rice-render — тема zellij из палитры rice (green = единый accent: рамка активной панели, вкладки)
themes {
    rice {
        fg "{{fg}}"
        bg "{{bg_alt}}"
        black "{{bg}}"
        red "{{urgent}}"
        green "{{accent}}"
        yellow "{{warn}}"
        blue "{{color4}}"
        magenta "{{color5}}"
        cyan "{{color6}}"
        white "{{fg}}"
        orange "{{warn}}"
    }
}
