// generated by rice-render — логотип = миниатюра текущих обоев (~/.cache/rice/logo.png, kitty graphics)
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty-direct",
        "source": "{{home}}/.cache/rice/logo.png",
        "width": 20,
        "height": 10,
        "padding": { "top": 0, "left": 1, "right": 3 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "{{accent_ansi}}", "title": "{{accent_ansi}}", "separator": "{{muted_ansi}}" },
        "key": { "width": 8 }
    },
    "modules": [
        "title",
        { "type": "custom", "format": "\u001b[{{muted_ansi}}m──────────────────────────────" },
        { "type": "os",       "key": "os" },
        { "type": "kernel",   "key": "kernel" },
        { "type": "wm",       "key": "wm" },
        { "type": "uptime",   "key": "uptime" },
        { "type": "packages", "key": "pkgs" },
        { "type": "memory",   "key": "mem" },
        { "type": "disk",     "key": "disk", "folders": "/" },
        { "type": "battery",  "key": "bat" },
        "break",
        { "type": "colors", "symbol": "circle" }
    ]
}
