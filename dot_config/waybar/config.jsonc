{
    "layer": "top",
    "position": "top",
    "height": 32,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 0,

    // группы модулей (стиль групп — #ws, #time, #net, #sys, #remote в style.css)
    "modules-left":   ["group/ws"],
    "modules-center": ["group/time"],
    "modules-right":  ["group/net", "group/sys", "group/remote", "tray"],

    "group/ws":     { "orientation": "horizontal", "modules": ["hyprland/workspaces", "custom/zellij"] },
    "group/time":   { "orientation": "horizontal", "modules": ["clock", "clock#utc"] },
    "group/net":    { "orientation": "horizontal", "modules": ["network", "bluetooth"] },
    "group/sys":    { "orientation": "horizontal", "modules": ["cpu", "memory", "battery"] },
    "group/remote": { "orientation": "horizontal", "modules": ["custom/weather", "custom/uptime"] },

    "hyprland/workspaces": {
        "format": "{name}"
    },

    // две таймзоны: локальная (системная) + UTC (время серверов)
    "clock": {
        "format": "{:%d/%m/%Y %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": { "mode": "month", "weeks-pos": "left" }
    },
    "clock#utc": {
        "timezone": "Etc/UTC",
        "format": "UTC {:%H:%M}",
        "tooltip-format": "UTC {:%d/%m/%Y %H:%M:%S}"
    },

    "battery": {
        "format": "BAT {capacity}%",
        "format-charging": "CHG {capacity}%",
        "states": { "warning": 25, "critical": 12 }
    },
    "cpu": {
        "format": "CPU {usage}%"
    },
    "memory": {
        "format": "MEM {percentage}%"
    },
    "network": {
        "format-wifi": "WiFi {essid}",
        "format-ethernet": "LAN {ifname}",
        "format-disconnected": "offline"
    },
    "bluetooth": {
        "format": "BT",
        "format-connected": "BT {device_alias}",
        "format-disabled": "BT off"
    },

    "custom/uptime": {
        "exec": "~/.local/bin/waybar-magic-uptime",
        "return-type": "json",
        "interval": 300,
        "signal": 8,
        "tooltip": true,
        "on-click": "pkill -RTMIN+8 waybar"
    },
    "custom/weather": {
        "exec": "~/.local/bin/waybar-weather",
        "return-type": "json",
        "interval": 1800,
        "tooltip": true
    },
    "custom/zellij": {
        "exec": "~/.local/bin/waybar-zellij",
        "return-type": "json",
        "interval": 5,
        "on-click": "kitty -e sh -c 'zellij attach \"$(zellij ls -n | grep -v EXITED | head -1 | cut -d\" \" -f1)\"'"
    },

    "tray": { "spacing": 8 }
}
