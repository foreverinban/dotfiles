;; sysmon — нагрузка по ядрам и памяти на рабочем столе (слой bottom: под окнами).
;; Цвета: ~/.cache/rice/eww-colors.scss (rice-render). Старт/стоп: rice-sysmon

;; Один график на логический поток. EWW_CPU.cores[i]; у i7-10610U их 8 (0..7).
;; Графики объявлены явно, а не через (for ...), — иначе история сбрасывается каждые 2 с.
(defwidget core [i]
  (box :class "core" :orientation "v" :space-evenly false
    (box :class "core-head" :space-evenly false
      (label :class "core-name" :halign "start" :hexpand true :text "C${i}")
      (label :class "core-val"  :halign "end"
             :text "${round(EWW_CPU.cores[i].usage, 0)}%"))
    (graph :class "g-core" :height 30
           :value {EWW_CPU.cores[i].usage}
           :min 0 :max 100 :time-range "60s" :thickness 1.5 :line-style "round")))

(defwidget sysmon []
  (box :class "sysmon" :orientation "v" :space-evenly false
    (box :class "head" :space-evenly false
      (label :class "title" :halign "start" :hexpand true :text "CPU")
      (label :class "value" :halign "end" :text "${round(EWW_CPU.avg, 0)}%"))
    (box :class "cores" :orientation "v" :space-evenly false
      (box :class "row" :spacing 8 (core :i 0) (core :i 1))
      (box :class "row" :spacing 8 (core :i 2) (core :i 3))
      (box :class "row" :spacing 8 (core :i 4) (core :i 5))
      (box :class "row" :spacing 8 (core :i 6) (core :i 7)))
    (box :class "head mem-head" :space-evenly false
      (label :class "title" :halign "start" :hexpand true :text "MEM")
      (label :class "value" :halign "end"
             :text "${round(EWW_RAM.used_mem / 1073741824, 1)}/${round(EWW_RAM.total_mem / 1073741824, 0)}G  ${round(EWW_RAM.used_mem_perc, 0)}%"))
    (graph :class "g-mem" :height 44
           :value {EWW_RAM.used_mem_perc}
           :min 0 :max 100 :time-range "120s" :thickness 2 :line-style "round")))

(defwindow sysmon
  :monitor 0
  :stacking "bottom"
  :exclusive false
  :focusable "none"
  :geometry (geometry :x "10px" :y "10px" :width "300px" :anchor "top right")
  (sysmon))
