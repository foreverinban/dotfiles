// zellij — тема из палитры rice (~/.config/zellij/themes/rice.kdl → ~/.cache/rice)
theme "rice"
default_shell "zsh"
default_layout "compact"

pane_frames true
ui {
    pane_frames {
        rounded_corners true
        hide_session_name false
    }
}

simplified_ui false
mouse_mode true
scroll_buffer_size 50000
copy_command "wl-copy"
copy_on_select true

show_startup_tips false
show_release_notes false
